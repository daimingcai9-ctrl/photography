# Public builds should leave local studio controls disabled.
NEXT_PUBLIC_ENABLE_LOCAL_STUDIO=false
NEXT_PUBLIC_ENABLE_REMOTE_STUDIO=false

# Used to create absolute Open Graph image URLs on photo detail pages.
NEXT_PUBLIC_SITE_URL=https://photography-hhs.pages.dev

# Cloudflare secrets are server-only. Configure with Wrangler, never NEXT_PUBLIC.
# ADMIN_PASSWORD: at least 12 characters
# SESSION_SECRET: random secret of at least 32 characters
