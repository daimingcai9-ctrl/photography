# Public builds should leave local studio controls disabled.
NEXT_PUBLIC_ENABLE_LOCAL_STUDIO=false

# Local default: http://localhost:3001/api/upload
# Future mobile upload: point this at an authenticated HTTPS API.
NEXT_PUBLIC_PHOTO_UPLOAD_ENDPOINT=http://localhost:3001/api/upload

# Used to create absolute Open Graph image URLs on photo detail pages.
NEXT_PUBLIC_SITE_URL=
