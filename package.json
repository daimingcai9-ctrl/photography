{
  "name": "personal-photograph-show",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "next dev --webpack",
    "studio": "node --import tsx scripts/local-studio.ts",
    "photos:sync": "node --import tsx scripts/sync-photos.ts",
    "photos:import": "node --import tsx scripts/import-mobile.ts",
    "dev:turbo": "next dev",
    "build": "node scripts/verify-android-ui.mjs && next build --webpack && tsx scripts/build-marker.ts",
    "start": "wrangler pages dev out --ip 127.0.0.1 --port 3000 --r2 PHOTO_BUCKET",
    "lint": "eslint",
    "extract-colors": "tsx scripts/extract-colors.ts",
    "upload-server": "tsx scripts/upload-server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "cf:dev": "wrangler pages dev out --ip 127.0.0.1 --port 8788 --r2 PHOTO_BUCKET",
    "android:build": "gradle -p android assembleDebug",
    "android:preview": "node scripts/preview-android.mjs",
    "android:publish-ui": "node scripts/publish-android-ui.mjs",
    "android:signing": "node --import tsx scripts/android-signing.ts"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "framer-motion": "^12.40.0",
    "heic-to": "1.6.5",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "4.146.0"
  }
}
